/* =====================================================================
   CounselX — original light indigo/purple design, applied to the new
   backend-connected frontend. Class names are unchanged so every JS
   module keeps working. Dark mode follows the system setting.
   ===================================================================== */
:root {
  --bg: #fbfbfe;
  --bg2: #f8fafc;
  --card: #ffffff;
  --tx: #1e1b4b;
  --mu: #596083;
  --ln: #edf0f8;
  --p: #5c4efc;
  --p2: #7c3aed;
  --ok: #047857;
  --okb: #d1fae5;
  --wa: #b45309;
  --wab: #fef3c7;
  --rc: #b91c1c;
  --rcb: #fee2e2;
  --sh: 0 8px 24px rgba(79, 70, 229, 0.04);
  --safe: #047857;
  --target: #5c4efc;
  --reach: #b45309;
  --r-sm: 12px;
  --r-md: 20px;
  --font: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e1124; --bg2: #161a35; --card: #1a1f3f; --tx: #eceefc; --mu: #a3a9cf; --ln: #2a3064;
    --okb: #053b2d; --wab: #3f2a05; --rcb: #450f0f; --ok: #6ee7b7; --wa: #fcd34d; --rc: #fca5a5;
    --p: #7c75ff; --target: #a5a0ff; --safe: #6ee7b7; --reach: #fcd34d;
    --sh: 0 10px 30px rgba(0, 0, 0, 0.3); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e1124; --bg2: #161a35; --card: #1a1f3f; --tx: #eceefc; --mu: #a3a9cf; --ln: #2a3064;
  --okb: #053b2d; --wab: #3f2a05; --rcb: #450f0f; --ok: #6ee7b7; --wa: #fcd34d; --rc: #fca5a5;
  --p: #7c75ff; --target: #a5a0ff; --safe: #6ee7b7; --reach: #fcd34d;
  --sh: 0 10px 30px rgba(0, 0, 0, 0.3); color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-padding-top: 80px; scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--tx); font-family: var(--font); line-height: 1.6; -webkit-font-smoothing: antialiased; }
h1, h2, h3, h4 { line-height: 1.2; margin: 0 0 0.5em; letter-spacing: -0.02em; }
h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; }
h2 { font-size: 1.3rem; font-weight: 700; }
h3 { font-size: 1.05rem; font-weight: 700; }
p { margin: 0 0 1em; color: var(--mu); }
a { color: var(--p); text-decoration: none; }
a:hover { text-decoration: underline; }
img, svg, canvas { max-width: 100%; }
code { background: var(--bg2); padding: 2px 6px; border-radius: 6px; font-size: 0.9em; }
[hidden] { display: none !important; }
.muted { color: var(--mu); }
.small { font-size: 0.85rem; }
.mt { margin-top: 24px; }
.sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.skip-link { position: absolute; left: 12px; top: -48px; background: var(--p); color: #fff; padding: 8px 16px; border-radius: 10px; z-index: 200; }
.skip-link:focus { top: 12px; text-decoration: none; }
:focus-visible { outline: 3px solid var(--p2); outline-offset: 2px; }
.page-title:focus { outline: none; }
.w { max-width: 1140px; margin: 0 auto; padding: 0 20px; }

.icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }

/* ---------- Header (sticky, blurred) ---------- */
.site-header {
  position: sticky; top: 0; z-index: 60; background: color-mix(in srgb, #ffffff 92%, transparent);
  backdrop-filter: blur(10px); border-bottom: 1px solid var(--ln);
}
.nb { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 72px; max-width: 1280px; }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.35rem; color: var(--tx); flex: none; letter-spacing: -0.02em; }
.logo:hover { text-decoration: none; }
.logo i { width: 38px; height: 38px; border-radius: 10px; background: #5c4efc; color: #fff; display: grid; place-items: center; font-style: normal; font-size: 1.15rem; }
.nav { display: flex; align-items: center; gap: 6px; }
.nav-link { display: inline-flex; align-items: center; gap: 4px; padding: 8px 16px; border-radius: 99px; font-weight: 600; font-size: 0.92rem; color: var(--mu); transition: 0.2s; white-space: nowrap; border: 1.5px solid transparent; }
.nav-link:hover { color: var(--p); text-decoration: none; }
.nav-link[aria-current="page"] { border-color: #e0e4f8; background: #ffffff; color: #5c4efc; text-decoration: none; }
.nav-badge { background: #5c4efc; color: #fff; border-radius: 99px; padding: 2px 7px; font-size: 0.72rem; margin-left: 4px; }
.nav .btn { margin-left: 8px; border-radius: 99px; background: #5c4efc; color: #fff !important; font-weight: 700; box-shadow: 0 4px 14px rgba(92, 78, 252, 0.25); }
.status-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 600; color: var(--mu); background: var(--bg2); border: 1px solid var(--ln); padding: 5px 12px; border-radius: 99px; margin-left: 8px; white-space: nowrap; }
.status-chip .dot { width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; flex: none; }
.status-chip[data-state="ok"] .dot { background: #10b981; box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2); }
.status-chip[data-state="down"] .dot { background: #ef4444; }
.icon-btn { display: none; background: none; border: 1px solid var(--ln); border-radius: 10px; width: 42px; height: 40px; place-items: center; color: var(--tx); cursor: pointer; }
.scrim { position: fixed; inset: 0; background: rgba(21, 26, 58, 0.35); z-index: 50; }

main { max-width: 1140px; width: 100%; margin: 0 auto; padding: 32px 20px 72px; }
main:focus { outline: none; }
.page { animation: pagein 0.35s ease both; }
@keyframes pagein { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

/* ---------- Buttons / chips / badges ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer; font: inherit; font-weight: 700;
  padding: 12px 22px; border-radius: 12px; background: transparent; color: var(--tx); transition: 0.2s; line-height: 1.2; text-decoration: none;
}
.btn:hover { text-decoration: none; transform: translateY(-2px); }
.btn:active { transform: none; }
.btn[disabled] { opacity: 0.5; cursor: not-allowed; transform: none; }
.btn-primary { background: linear-gradient(135deg, var(--p), var(--p2)); color: #fff; box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3); }
.btn-primary:hover { box-shadow: 0 12px 26px rgba(79, 70, 229, 0.4); color: #fff; }
.btn-secondary { background: transparent; color: var(--p); border: 2px solid var(--p); padding: 10px 20px; }
.btn-secondary:hover { background: var(--bg2); }
.btn-ghost { color: var(--mu); border: 1.5px solid var(--ln); padding: 8px 14px; }
.btn-ghost:hover { color: var(--p); border-color: var(--p); background: var(--bg2); }
.btn-sm { padding: 8px 14px; font-size: 0.88rem; }
.btn-secondary.btn-sm { padding: 6px 12px; }
.btn-lg { padding: 15px 30px; font-size: 1.05rem; }
.btn-secondary.btn-lg { padding: 13px 28px; }
.btn-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.btn[aria-pressed="true"] { border-color: var(--ok); color: var(--ok); background: var(--okb); }
.link-btn { background: none; border: 0; padding: 0; color: var(--mu); font: inherit; cursor: pointer; text-align: left; }
.link-btn:hover { color: var(--p); }

.chip { display: inline-flex; align-items: center; background: var(--bg2); border: 1px solid var(--ln); border-radius: 99px; padding: 4px 12px; font-size: 0.82rem; font-weight: 600; }
.chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: 0.78rem; font-weight: 800; background: var(--bg2); border: 1px solid var(--ln); color: var(--mu); }
.badge-soft { background: var(--wab); border-color: transparent; color: var(--wa); }
.badge-type { background: #e0e7ff; border-color: transparent; color: var(--p); }
.badge-adv { background: #ede9fe; border-color: #c4b5fd; color: #6d28d9; }
.badge-main { background: #e0f2fe; border-color: #bae6fd; color: #0369a1; }
.tag-status { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font-size: 0.76rem; font-weight: 700; }
.status-within { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
.status-outside { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) .badge-adv { background: #2e1065; border-color: #5b21b6; color: #ddd6fe; }
  :root:not([data-theme="light"]) .badge-main { background: #082f49; border-color: #0369a1; color: #bae6fd; }
  :root:not([data-theme="light"]) .status-within { background: #14532d; color: #86efac; border-color: #166534; }
  :root:not([data-theme="light"]) .status-outside { background: #7f1d1d; color: #fca5a5; border-color: #991b1b; }
}

/* ---------- Cards, grids ---------- */
.card { background: var(--card); border: 1px solid var(--ln); border-radius: 20px; padding: 26px; box-shadow: var(--sh); transition: 0.25s; }
.card-title { display: flex; align-items: center; gap: 8px; font-size: 1.05rem; margin-bottom: 16px; }
.grid { display: grid; gap: 22px; }
.grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; padding: 12px 0 18px; }
.page-head p { margin: 0; }
.section { margin-top: 64px; }
.section-title { font-size: clamp(1.6rem, 3.5vw, 2.2rem); text-align: center; margin-bottom: 8px; }
.section-sub { text-align: center; max-width: 620px; margin: 0 auto 32px; }
.callout { display: grid; gap: 12px; justify-items: start; margin-bottom: 24px; border-color: var(--wa); }
.back-link { display: inline-block; margin-bottom: 16px; color: var(--p); font-weight: 700; }

.alert { padding: 12px 16px; border-radius: 12px; border: 1px solid var(--ln); font-size: 0.9rem; margin: 0 0 16px; color: var(--tx); }
.alert-info { background: var(--bg2); border-left: 4px solid var(--p2); }
.alert-error { background: var(--rcb); border-color: var(--rc); color: var(--rc); }
.alert-warn { background: var(--wab); border-color: var(--wa); color: var(--wa); }

/* ---------- Hero ---------- */
.hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; padding: 32px 0 24px; background: radial-gradient(600px 300px at 90% 0, rgba(124, 58, 237, 0.12), transparent); }
.hero-title { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; }
.lead { font-size: 1.1rem; max-width: 540px; color: var(--mu); }
.pill, .eyebrow { display: inline-flex; align-items: center; gap: 6px; background: var(--bg2); color: var(--p); border: 1px solid var(--ln); border-radius: 99px; padding: 5px 14px; font-size: 0.85rem; font-weight: 700; margin-bottom: 18px; }
.hero-rank { margin: 0 0 20px; max-width: 460px; }
.hero-rank label { display: block; margin-bottom: 6px; }
.inline { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.hero-rank .inline { flex-wrap: nowrap; }
.hero-rank input { flex: 1 1 auto; width: auto; min-width: 0; }
.tagline { margin: 20px 0 0; color: var(--p); font-weight: 700; }
.hero-stats { display: flex; gap: 32px; margin-top: 20px; flex-wrap: wrap; }
.hero-stats > div { display: grid; }
.hero-stat-num { font-size: 1.6rem; font-weight: 800; color: var(--p); }
.hero-stat-label { color: var(--mu); font-size: 0.82rem; max-width: 24ch; }
.hero-art { position: relative; min-height: 340px; display: grid; place-items: center; }
.hero-art svg { width: 100%; max-width: 400px; }
.fl { position: absolute; background: var(--card); border: 1px solid var(--ln); border-radius: 14px; padding: 10px 14px; box-shadow: var(--sh); font-size: 0.85rem; font-weight: 700; animation: fl 4s ease-in-out infinite; }
.fl small { display: block; color: var(--mu); font-weight: 500; }
@keyframes fl { 50% { transform: translateY(-10px); } }

.feature-ic, .ic { width: 52px; height: 52px; border-radius: 14px; background: linear-gradient(135deg, #e0e7ff, #ede9fe); display: grid; place-items: center; font-size: 1.5rem; margin-bottom: 16px; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .feature-ic { background: linear-gradient(135deg, #2a2f6e, #3a2a6e); } }
.feature { transition: 0.25s; }
.feature:hover, .tier-card:hover { transform: translateY(-4px); }
.feature p, .step p { margin: 0; font-size: 0.92rem; }
.alt-band { background: var(--bg2); margin-top: 64px; padding: 64px 0; box-shadow: 0 0 0 100vmax var(--bg2); clip-path: inset(0 -100vmax); }
.alt-band .section { margin-top: 0; }
.steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
.step-num { width: 38px; height: 38px; border-radius: 50%; background: var(--p); color: #fff; display: grid; place-items: center; font-weight: 800; margin-bottom: 14px; }
.tier-card { border-left: 4px solid; }
.tier-card h3 { margin-bottom: 4px; }
.tier-card p { margin: 0; font-size: 0.92rem; }
.tier-card.tier-safe { border-left-color: var(--safe); } .tier-card.tier-safe h3 { color: var(--safe); }
.tier-card.tier-target { border-left-color: var(--target); } .tier-card.tier-target h3 { color: var(--target); }
.tier-card.tier-reach { border-left-color: var(--reach); } .tier-card.tier-reach h3 { color: var(--reach); }
.cta-band { margin-top: 64px; background: linear-gradient(135deg, var(--p), var(--p2)); color: #fff; border-radius: 24px; padding: 48px 28px; text-align: center; }
.cta-band h2 { color: #fff; font-size: clamp(1.6rem, 3.5vw, 2.2rem); }
.cta-band p { color: #e0e0ff; }
.cta-band .btn-primary { background: #fff; color: var(--p); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); }

/* ---------- Dashboard ---------- */
#dash-stats .card {
  background: var(--card);
  border: 1.5px solid var(--ln);
  border-radius: 20px;
  padding: 24px;
  box-shadow: var(--sh);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
#dash-stats .card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(79, 70, 229, 0.08);
}
#dash-stats h3 {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--mu);
  margin: 0 0 8px;
}
#dash-stats p {
  font-size: 1.95rem;
  font-weight: 800;
  color: var(--p);
  margin: 0;
  font-variant-numeric: tabular-nums;
}
.stat { display: grid; gap: 4px; padding: 20px; }
.stat-label { color: var(--mu); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
.stat-value { font-size: 1.6rem; font-weight: 800; color: var(--p); word-break: break-word; line-height: 1.2; }
.stat-note { color: var(--mu); font-size: 0.8rem; }
.mini-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
.mini-item { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 14px 16px; border: 1.5px solid var(--ln); border-radius: 14px; background: var(--bg2); }
.mini-item a { font-weight: 700; color: var(--tx); font-size: 0.95rem; }
.mini-item a:hover { color: var(--p); text-decoration: none; }
.mini-item small { color: var(--mu); display: block; font-size: 0.82rem; margin-top: 2px; }

/* ---------- Forms ---------- */
.form-card { max-width: 860px; margin-bottom: 40px; }
.stepper { list-style: none; display: flex; gap: 8px; padding: 0; margin: 0 0 24px; flex-wrap: wrap; }
.stepper li { flex: 1 1 140px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 99px; border: 1.5px solid var(--ln); color: var(--mu); font-weight: 600; font-size: 0.85rem; }
.stepper li span { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--bg2); font-size: 0.8rem; }
.stepper li.active { color: #fff; border-color: var(--p); background: var(--p); }
.stepper li.active span { background: #fff; color: var(--p); }
.stepper li.done { color: var(--ok); border-color: var(--ok); }
.stepper li.done span { background: var(--ok); color: #fff; }
fieldset { border: 0; padding: 0; margin: 0; min-inline-size: 0; }
legend { font-size: 1.15rem; font-weight: 700; margin-bottom: 16px; padding: 0; }
.form-grid, .filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.filter-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-bottom: 16px; }
.field { display: grid; gap: 6px; align-content: start; }
label { font-weight: 700; font-size: 0.9rem; }
.optional { color: var(--mu); font-weight: 400; }
input, select, textarea { width: 100%; font: inherit; color: var(--tx); background: var(--bg); border: 1.5px solid var(--ln); border-radius: 12px; padding: 12px 14px; min-height: 46px; transition: 0.2s; }
select option { background: var(--bg); color: var(--tx); }
input:focus, select:focus { outline: none; border-color: var(--p); box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15); }
input[aria-invalid="true"], select[aria-invalid="true"] { border-color: var(--rc); }
.field-hint { color: var(--mu); font-size: 0.8rem; margin: 0; }
.field-error { color: var(--rc); font-size: 0.85rem; margin: 0; }
.field-error:empty { display: none; }
.form-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; }
.select-sm, .input-sm { width: auto; min-height: 36px; padding: 5px 10px; font-size: 0.85rem; border-radius: 10px; }
.filters { margin-bottom: 24px; }
.review { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; margin: 0 0 16px; }
.review div { display: grid; padding-bottom: 8px; border-bottom: 1px solid var(--ln); }
.review dt { color: var(--mu); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
.review dd { margin: 0; font-weight: 700; }

/* ---------- Results table (cards on small screens) ---------- */
.results-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.results-bar p { margin: 0; }
.table-wrap { border: 1px solid var(--ln); border-radius: 20px; overflow-x: auto; background: var(--card); box-shadow: var(--sh); }
table.data { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.data th { text-align: left; padding: 12px; background: var(--bg2); color: var(--mu); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--ln); white-space: nowrap; }
.data td { padding: 12px; border-bottom: 1px solid var(--ln); vertical-align: top; }
.data tbody tr:hover { background: var(--bg2); }
.data tbody tr:last-child td { border-bottom: 0; }
.data .num { font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }
.row-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.pagination { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin: 24px 0; }
.pagination button { min-width: 40px; }
.pagination .current { background: var(--p); border-color: var(--p); color: #fff; }

.empty-state { text-align: center; padding: 48px 24px; border: 2px dashed var(--ln); border-radius: 20px; color: var(--mu); display: grid; gap: 8px; justify-items: center; background: var(--bg2); }
.empty-state svg.art { width: 72px; height: 72px; stroke: var(--p2); fill: none; stroke-width: 1.5; opacity: 0.8; }
.empty-state h3 { color: var(--tx); margin: 0; }
.empty-state p { margin: 0; max-width: 520px; }

.skeleton { background: linear-gradient(90deg, var(--bg2) 25%, var(--ln) 50%, var(--bg2) 75%); background-size: 200% 100%; animation: shimmer 1.4s infinite; border-radius: 12px; }
@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
.skel-row { height: 52px; margin-bottom: 8px; }
.skel-card { height: 150px; margin-bottom: 12px; }

/* Filter tabs */
.filter-tabs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--ln); }
.filter-tabs .btn { border-radius: 99px; padding: 7px 18px; font-weight: 700; font-size: 0.88rem; transition: 0.2s; }
.filter-tabs .btn-primary { background: #5c4efc; color: #fff; box-shadow: 0 4px 12px rgba(92, 78, 252, 0.2); }
.filter-tabs .btn-ghost { background: #fff; border: 1.5px solid var(--ln); color: var(--mu); }
.filter-tabs .btn-ghost:hover { border-color: #d1d5f0; color: var(--tx); }

/* ---------- Recommendation cards (modern 3-column reference style) ---------- */
.tier-section { margin-top: 32px; }
.tier-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
.tier-head h2 { margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--tx); }
.tier-count { font-weight: 800; font-size: 0.8rem; }
.tier-note { color: var(--mu); font-size: 0.9rem; margin-bottom: 20px; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 24px; }
.rec-card {
  background: var(--card);
  border: 1.5px solid var(--ln);
  border-radius: 20px;
  padding: 24px 24px 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
  box-shadow: 0 8px 24px rgba(79, 70, 229, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.rec-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 32px rgba(79, 70, 229, 0.09);
}
.card-head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
.rec-card h3.college-name { margin: 0 0 3px; font-size: 1.15rem; font-weight: 800; color: var(--tx); letter-spacing: -0.01em; }
.rec-title { min-height: 48px; }
.rec-prog { color: var(--mu); font-size: 0.86rem; margin: 0; line-height: 1.4; }
.card-badge-group { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.type-badge { background: var(--bg2); color: var(--mu); font-size: 0.74rem; font-weight: 700; padding: 4px 10px; border-radius: 99px; }

.card-desc.reason {
  font-size: 0.88rem;
  color: var(--mu);
  line-height: 1.55;
  background: var(--bg2);
  border-radius: 12px;
  padding: 10px 14px;
  border-left: 3.5px solid var(--p);
  margin: 0;
}

/* 3-stat boxes */
.stat-boxes {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin: 4px 0 0;
}
.stat-box {
  background: var(--bg2);
  border-radius: 12px;
  padding: 10px 12px;
  text-align: left;
}
.stat-box small {
  display: block;
  color: var(--mu);
  font-size: 0.72rem;
  font-weight: 600;
  margin-bottom: 2px;
  text-transform: capitalize;
  letter-spacing: 0.02em;
}
.stat-box b {
  font-size: 0.98rem;
  font-weight: 800;
  color: var(--tx);
  font-variant-numeric: tabular-nums;
}

/* Action button row */
.card-actions-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}
.btn-details-purple {
  flex: 1;
  background: #5c4efc;
  color: #ffffff !important;
  border: none;
  padding: 12px 18px;
  border-radius: 12px;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  font-size: 0.95rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(92, 78, 252, 0.22);
  transition: background 0.2s, transform 0.2s;
}
.btn-details-purple:hover {
  background: #4e3fe8;
  transform: translateY(-1px);
  text-decoration: none;
}
.card-icon-actions { display: flex; gap: 6px; }
.load-more { margin-top: 16px; text-align: center; }

/* ---------- College details ---------- */
.detail-hero { background: linear-gradient(135deg, var(--p), var(--p2)); color: #fff; border-radius: 24px; padding: 36px 30px; margin-bottom: 24px; display: grid; gap: 16px; }
.detail-hero .rec-prog, .detail-hero h2 { color: #fff; }
.detail-hero h2 { font-size: clamp(1.5rem, 3.5vw, 2.2rem); margin: 0; }
.detail-hero .badge { background: rgba(255, 255, 255, 0.18); border-color: transparent; color: #fff; }
.detail-hero .rank-box { background: rgba(255, 255, 255, 0.15); }
.detail-hero .rank-box small { color: #e0e0ff; }
.detail-hero .btn-ghost { color: #fff; border-color: rgba(255, 255, 255, 0.5); }
.detail-hero .btn-ghost:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
.detail-hero .btn[aria-pressed="true"] { background: #fff; color: var(--p); border-color: #fff; }
.detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin: 0; }
.kv { background: var(--card); border: 1px solid var(--ln); border-radius: 14px; padding: 12px 16px; }
.kv dt { color: var(--mu); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
.kv dd { margin: 4px 0 0; font-weight: 700; word-break: break-word; }
details.raw { margin-top: 16px; } details.raw summary { cursor: pointer; font-weight: 700; color: var(--mu); }
details.raw pre { background: var(--bg2); padding: 16px; border-radius: 12px; overflow: auto; font-size: 0.8rem; }

/* ---------- Charts ---------- */
.chart-card { min-width: 0; }
.chart-wide { grid-column: 1 / -1; }
.chart-body { position: relative; height: 300px; margin-top: 12px; }
.chart-tall { height: 380px; }
.chart-body canvas { width: 100% !important; height: 100% !important; }
.chart-body.is-empty canvas { display: none; }
.chart-empty { display: none; position: absolute; inset: 0; place-items: center; text-align: center; color: var(--mu); border: 2px dashed var(--ln); border-radius: 12px; padding: 16px; margin: 0; background: var(--bg2); }
.chart-body.is-empty .chart-empty { display: grid; }
.chart-sub { margin-bottom: 0; }

/* ---------- Compare ---------- */
.cmp-wrap { overflow-x: auto; border: 1px solid var(--ln); border-radius: 20px; background: var(--card); box-shadow: var(--sh); }
table.cmp { border-collapse: collapse; width: 100%; min-width: 640px; }
.cmp th, .cmp td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--ln); vertical-align: top; }
.cmp thead th { background: var(--bg2); }
.cmp tbody th { color: var(--mu); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; width: 160px; white-space: nowrap; }
.cmp td.differs { background: var(--wab); box-shadow: inset 3px 0 0 var(--wa); }
.cmp td.best { background: var(--okb); box-shadow: inset 3px 0 0 var(--ok); }
.cmp td.best::after { content: ' ✓ best'; color: var(--ok); font-size: 0.75rem; font-weight: 800; }
.shortlist-list { display: grid; gap: 18px; }
.shortlist-list .card { display: grid; gap: 12px; }
.shortlist-list h3 { margin: 0; }

/* ---------- Misc ---------- */
.prose { max-width: 760px; } .prose h2 { margin-top: 24px; } .prose h2:first-child { margin-top: 0; }
.footer { border-top: 1px solid var(--ln); padding: 40px 20px 28px; background: var(--bg2); }
.footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; max-width: 1140px; margin: 0 auto 24px; }
.footer-h { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mu); margin-bottom: 4px; }
.footer nav { display: grid; gap: 4px; align-content: start; }
.footer nav a { color: var(--mu); padding: 3px 0; } .footer nav a:hover { color: var(--p); text-decoration: none; }
.disclaimer { display: flex; gap: 12px; max-width: 1140px; margin: 0 auto; padding: 16px; border: 1px solid var(--ln); border-radius: 14px; font-size: 0.82rem; color: var(--mu); background: var(--card); }
.compare-tray { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); translate: -50% 0; z-index: 70; display: flex; gap: 16px; align-items: center; padding: 10px 14px 10px 20px; background: var(--card); border: 1px solid var(--ln); border-radius: 99px; box-shadow: var(--sh); font-weight: 700; }
.toasts { position: fixed; left: 50%; translate: -50% 0; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); display: grid; gap: 8px; z-index: 90; width: max-content; max-width: min(420px, calc(100vw - 32px)); }
.toast { background: var(--tx); color: var(--bg); padding: 12px 22px; border-radius: 12px; font-weight: 600; box-shadow: var(--sh); animation: pagein 0.25s ease both; }
.toast.error { background: var(--rc); color: #fff; } .toast.warn { background: var(--wa); color: #fff; }
.dialog { background: var(--card); color: var(--tx); border: 1px solid var(--ln); border-radius: 20px; padding: 28px; max-width: 480px; box-shadow: var(--sh); }
.dialog::backdrop { background: rgba(21, 26, 58, 0.55); }
.dialog p { color: var(--mu); }

/* ---------- Responsive ---------- */
@media (max-width: 1180px) {
  .icon-btn { display: grid; }
  .nav { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 2px; background: var(--bg); padding: 12px 20px 16px; border-bottom: 1px solid var(--ln); max-height: calc(100vh - 66px); overflow-y: auto; }
  body.nav-open .nav { display: flex; }
  .nav .btn, .status-chip { margin: 8px 0 0; }
  .status-chip { align-self: flex-start; }
}
@media (max-width: 960px) {
  .hero { grid-template-columns: 1fr; }
  .hero-art { min-height: 280px; }
  .grid-4, .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-2 { grid-template-columns: 1fr; }
  .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 720px) {
  main { padding: 20px 16px 56px; }
  .grid-3, .grid-4, .steps, .form-grid, .filter-grid, .review, .footer-grid { grid-template-columns: 1fr; }
  .alt-band { padding: 48px 0; }
  .section { margin-top: 48px; }
  .fl { display: none; }
  .hero-stats { gap: 16px; }
  .cards { grid-template-columns: 1fr; }
  .rec-title { min-height: 0; }
  .table-wrap { overflow: visible; }
  table.data thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  table.data, table.data tbody, table.data tr, table.data td { display: block; width: 100%; }
  table.data tr { padding: 12px; border-bottom: 1px solid var(--ln); }
  table.data td { display: flex; justify-content: space-between; gap: 16px; border: 0; padding: 4px 0; text-align: right; }
  table.data td::before { content: attr(data-label); color: var(--mu); font-weight: 600; text-align: left; flex: none; }
  .compare-tray { width: calc(100% - 32px); justify-content: space-between; border-radius: 16px; }
  .form-actions .btn { flex: 1; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
}


